# ==============================================
# SUPABASE
# ==============================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Service role key - ONLY use server-side (API functions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==============================================
# RESEND (Transactional Emails)
# ==============================================
# Sign up at https://resend.com
# Create API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# ==============================================
# BREVO (Marketing Emails / Property Alerts)
# ==============================================
# Sign up at https://www.brevo.com
# Create API key at Settings > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxx

# List ID for property alert subscribers (create in Brevo)
BREVO_ALERTS_LIST_ID=1

# ==============================================
# EMAIL SETTINGS
# ==============================================
# Admin email to receive inquiry notifications
ADMIN_EMAIL=info@trata.pt

# From email address (must be verified with your email provider)
FROM_EMAIL=noreply@trata.pt
FROM_NAME=Trata Imobiliária

# ==============================================
# SITE CONFIG
# ==============================================
SITE_URL=https://trata-lovat.vercel.app

# API URL (usually same as SITE_URL for Vercel)
VITE_API_URL=https://trata-lovat.vercel.app

# ==============================================
# SECURITY
# ==============================================
# Webhook secret for API endpoints (generate a random string)
# Used to validate requests to /api/send-property-alerts
WEBHOOK_SECRET=your_random_secret_here
